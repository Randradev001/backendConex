# Copie este archivo como .env.database. No reutilice una clave de produccion.
# SQL Server exige al menos 8 caracteres y mezcla de mayusculas, minusculas,
# numeros y simbolos.
MSSQL_SA_PASSWORD=Cambie_Esta-Clave_2026!

# Puerto visible solo en este computador. Internamente Docker usa 1433.
CONEX_DB_PORT=14330
