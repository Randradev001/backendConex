CONEX_ENV_FILE=.env.backend
NODE_ENV=production
PORT=3000

DB_SERVER=
DB_PORT=1433
DB_DATABASE=CONEX
DB_USER=
DB_PASSWORD=
DB_INSTANCE=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

CORS_ORIGINS=https://www.conexco.cl
SESSION_HOURS=12
SESSION_REMEMBER_HOURS=720
SESSION_COOKIE_NAME=conex_session
SECURITY_ADMIN_ROLES=ADMINFULL

# El servidor web no debe abrir conexiones TCP hacia las impresoras locales.
PRINT_WORKER_ENABLED=false

# API consumida por un único agente local en la primera etapa.
PRINT_AGENT_API_ENABLED=true
PRINT_AGENT_ID=packing-principal-01
PRINT_INSTALLATION_ID=planta-principal-01
PRINT_AGENT_EMP_COD=1
PRINT_AGENT_TOKEN=
PRINT_PORT=9100
PRINT_TIMEOUT_MS=5000
