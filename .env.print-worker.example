CONEX_ENV_FILE=.env.print-worker
NODE_ENV=production

# Primera etapa: el worker usa la base local existente.
PRINT_WORKER_ENABLED=false
PRINT_QUEUE_SOURCE=database
PRINT_CONTEXT_SOURCE=database
PRINT_EMP_COD=1
PRINT_POLL_MS=750
PRINT_PORT=9100
PRINT_TIMEOUT_MS=5000

DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=CONEX
DB_USER=
DB_PASSWORD=
DB_INSTANCE=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Futuro contexto web: la cola OrdenImpresion continúa en la base local.
# PRINT_CONTEXT_SOURCE=api
# PRINT_API_URL=https://api.ejemplo.cl/backendDocker/print-agent/v1
# PRINT_AGENT_ID=packing-principal-01
# PRINT_AGENT_TOKEN=
