CONEX_ENV_FILE=.env.print-worker
NODE_ENV=production

PRINT_WORKER_ENABLED=true

# El PLC siempre escribe la cola local; solo el contexto y ZPL vienen de la web.
PRINT_QUEUE_SOURCE=database
PRINT_CONTEXT_SOURCE=api

PRINT_EMP_COD=1
PRINT_POLL_MS=750
PRINT_PORT=9100
PRINT_TIMEOUT_MS=5000

# SQL Server local de la planta: contiene OrdenImpresion.
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=CONEX
DB_USER=
DB_PASSWORD=
DB_INSTANCE=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Use HTTPS en producción. Para probar temporalmente contra la IP HTTP actual,
# cambie la URL a http://190.3.171.48:3000 y habilite la excepción explícita.
PRINT_API_URL=https://www.conexco.cl/backendDocker/print-agent/v1
PRINT_API_ALLOW_INSECURE_HTTP=false
PRINT_AGENT_ID=packing-principal-01
PRINT_INSTALLATION_ID=planta-principal-01
PRINT_AGENT_TOKEN=
PRINT_LOCAL_SPOOL=C:\ProgramData\ConexPrintAgent\spool
