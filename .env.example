NODE_ENV=development
PORT=3000

DB_SERVER=
DB_PORT=1433
DB_DATABASE=
DB_USER=
DB_PASSWORD=
DB_INSTANCE=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_HOURS=12
SESSION_REMEMBER_HOURS=720
SESSION_COOKIE_NAME=conex_session
SECURITY_ADMIN_ROLES=ADMINFULL

# Worker silencioso de impresión (deshabilitado por seguridad hasta la puesta en marcha)
PRINT_WORKER_ENABLED=false
PRINT_EMP_COD=1
PRINT_POLL_MS=750
PRINT_PORT=9100
PRINT_TIMEOUT_MS=5000
